# -----------------------------------------------------------------------------
# hh_mntb_kv31_neuron
#
# Neurone MNTB a singolo compartimento (soma).
#
#   REF1 = Macica et al. 2003, J Neurosci 23:1133
#   REF2 = Wang et al. 1998, J Physiol 509.1:183
#
# EQUAZIONI GENERALI  -> REF2 ("Numerical simulations"):
#   C dV/dt = I_HT + I_LT + I_Na + g_L (E_L - V) + I_ext
#   I_HT = g_HT n^3 (1 - gamma + gamma p) (E_K - V)
#   I_LT = g_LT l r (E_K - V)
#   I_Na = g_Na m^3 h (E_Na - V)
#   dj/dt = alpha_j (1 - j) - beta_j j,   alpha_j = k_aj exp(eta_aj V),  beta_j = k_bj exp(eta_bj V)
#   (REF2 scrive "- beta_j" senza il fattore j: e' un refuso, la forma standard e' quella sopra.
#    Gli esponenti di n e m non sono leggibili nel PDF di REF2: uso 3, come in REF1.)
#
# PARAMETRI           -> REF1 (tutti, compresi quelli del sodio, E_L e gamma)
# EQUAZIONE AGGIUNTIVA -> REF1: modulazione PKC (PMA) dell'ampiezza di Kv3.1,
#                         g_HT: 150 nS (controllo) -> 100 nS (PMA), -32.4 % su Kv3.1b
#
# Cio' che NON viene dai paper e' marcato con [NON DA REF].
# -----------------------------------------------------------------------------
model hh_mntb_kv31_neuron:

    state:
        # Stato stazionario con i parametri di default (V_rest = -64.5 mV;
        # REF1 misura un potenziale di riposo medio di -64.2 mV)
        V_m mV = -64.5 mV

        Act_n real   = 0.0945   # attivazione I_HT (Kv3.1)
        Inact_p real = 1.0      # inattivazione parziale I_HT
        Act_l real   = 0.0661   # attivazione I_LT
        Inact_r real = 0.4475   # inattivazione I_LT
        Act_m real   = 0.0595   # attivazione I_Na
        Inact_h real = 0.6728   # inattivazione I_Na

        refr_count integer = 0  # [NON DA REF] contatore per il rilevamento degli spike

    parameters:
        # ---- Capacita' e conduttanze massime (REF1) ----------------------------
        C_m pF  = 10 pF       # 0.01 nF
        g_Na nS = 500 nS      # 0.5 uS
        g_LT nS = 20 nS       # 0.02 uS
        g_HT nS = 150 nS      # 0.15 uS (controllo); 0.10 uS dopo PMA
        g_L nS  = 2 nS        # 0.002 uS

        # ---- Potenziali di inversione (REF1) ----------------------------------
        E_K mV  = -80 mV
        E_Na mV = 50 mV
        E_L mV  = -63 mV      # REF1: I_L = g_L (-63 - V)

        # ---- Forma di I_HT (REF1: n^3 (0.8 + 0.2 p)) ---------------------------
        gamma_p real = 0.2

        # ---- Equazione aggiuntiva REF1: modulazione PKC di Kv3.1 ---------------
        PKC_level real = 0.0              # 0 = nessuna attivazione, 1 = PMA 100 nM (effetto massimo, 10-15 min)
        PKC_inhib_Kv31b real = 0.324      # inibizione di Kv3.1b da PMA (32.4 +/- 4.3 %)
        PKC_inhib_Kv31a real = 0.0226     # inibizione di Kv3.1a da PMA (2.26 +/- 1.7 %, non significativa)
        frac_Kv31b real = 1.0             # frazione di canali Kv3.1b (adulto: predominante)
        frac_S503A real = 0.0             # frazione di Kv3.1b mutato S503A (insensibile alla PKC)
        Kv31_expression real = 1.0        # 1 = wild type; ~0.1 = Kv3.1-/- (corrente ridotta di >90 %); 0 = eliminazione totale

        # ---- Rilevamento spike [NON DA REF] ------------------------------------
        V_thr mV  = 0 mV
        refr_T ms = 0.5 ms    # solo conteggio degli spike; 2 ms nasconderebbe gli spike a >= 500 Hz

        # ---- Sinapsi e corrente costante [NON DA REF, dal file hh_psc_alpha_neuron_sca13] ----
        tau_syn_exc ms = 0.2 ms
        tau_syn_inh ms = 2.0 ms
        I_e pA = 0 pA

    internals:
        refr_counts integer = steps(refr_T)

        # Equazione aggiuntiva REF1: g_HT effettiva sotto PKC. Solo il Kv3.1b non mutato e' sensibile;
        # la PKC cambia l'ampiezza ma non cinetica ne' V1/2 di attivazione (REF1, Fig. 3 e 7).
        # Con PKC_level = 1 e frac_Kv31b = 1: 150 nS * (1 - 0.324) = 101 nS (REF1 usa 100 nS)
        pkc_inhibition real = PKC_level * ( frac_Kv31b * (1 - frac_S503A) * PKC_inhib_Kv31b + (1 - frac_Kv31b) * PKC_inhib_Kv31a )
        g_HT_eff nS = g_HT * Kv31_expression * (1 - pkc_inhibition)

    equations:
        # ---- Sinapsi (alpha) [NON DA REF] --------------------------------------
        kernel K_syn_inh = (e/tau_syn_inh) * t * exp(-t/tau_syn_inh)
        kernel K_syn_exc = (e/tau_syn_exc) * t * exp(-t/tau_syn_exc)
        inline I_syn_exc pA = convolve(K_syn_exc, exc_spikes) * 1 pA
        inline I_syn_inh pA = convolve(K_syn_inh, inh_spikes) * 1 pA

        # ---- Correnti (equazioni REF2, convenzione: positiva = uscente) --------
        inline I_HT pA   = g_HT_eff * Act_n**3 * ((1 - gamma_p) + gamma_p * Inact_p) * (V_m - E_K)
        inline I_LT pA   = g_LT * Act_l * Inact_r * (V_m - E_K)
        inline I_Na pA   = g_Na * Act_m**3 * Inact_h * (V_m - E_Na)
        inline I_Leak pA = g_L * (V_m - E_L)

        # ---- Costanti cinetiche alpha_j = k exp(eta V), beta_j = k exp(eta V): parametri REF1 ----
        # Kv3.1 (n, p)
        inline alpha_n real = 0.2719 * exp(0.04 * V_m / (1 mV))
        inline beta_n real  = 0.1974
        inline alpha_p real = 0.00713 * exp(-0.1942 * V_m / (1 mV))
        inline beta_p real  = 0.0935 * exp(0.0058 * V_m / (1 mV))
        # bassa soglia (l, r)
        inline alpha_l real = 1.2 * exp(0.03512 * V_m / (1 mV))
        inline beta_l real  = 0.2248 * exp(-0.0319 * V_m / (1 mV))
        inline alpha_r real = 0.0438 * exp(-0.0053 * V_m / (1 mV))
        inline beta_r real  = 0.0562 * exp(-0.0047 * V_m / (1 mV))
        # sodio (m, h): valori di REF1
        inline alpha_m real = 76.4 * exp(0.037 * V_m / (1 mV))
        inline beta_m real  = 6.93 * exp(-0.043 * V_m / (1 mV))
        inline alpha_h real = 0.000533 * exp(-0.0909 * V_m / (1 mV))
        inline beta_h real  = 7.87 * exp(0.0691 * V_m / (1 mV))

        Act_n'   = (alpha_n * (1 - Act_n)     - beta_n * Act_n)     / (1 ms)
        Inact_p' = (alpha_p * (1 - Inact_p)   - beta_p * Inact_p)   / (1 ms)
        Act_l'   = (alpha_l * (1 - Act_l)     - beta_l * Act_l)     / (1 ms)
        Inact_r' = (alpha_r * (1 - Inact_r)   - beta_r * Inact_r)   / (1 ms)
        Act_m'   = (alpha_m * (1 - Act_m)     - beta_m * Act_m)     / (1 ms)
        Inact_h' = (alpha_h * (1 - Inact_h)   - beta_h * Inact_h)   / (1 ms)

        # ---- Equazione del potenziale di membrana (REF2) -----------------------
        V_m' = ( -(I_HT + I_LT + I_Na + I_Leak) + I_e + I_stim + I_syn_exc - I_syn_inh ) / C_m

    input:
        exc_spikes <- excitatory spike
        inh_spikes <- inhibitory spike
        I_stim pA <- continuous

    output:
        spike

    update:
        V_m_old mV = V_m
        integrate_odes()

        # spike = massimo locale sopra soglia, poi pseudo-refrattarieta' (conteggio)
        if refr_count > 0:
            refr_count -= 1
        elif V_m > V_thr and V_m_old > V_m:
            refr_count = refr_counts
            emit_spike()
