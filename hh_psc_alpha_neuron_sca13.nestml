model hh_psc_alpha_neuron_sca13:
    state:
        V_m mV = -60.0 mV        # Potenziale di riposo
        V_m_old mV = -60.0 mV
        refr_t ms = 0 ms

        # Variabili di gating (inizializzate a valori di riposo approssimativi)
        n real = 0.01  # Attivazione I_HT
        p real = 0.99  # Inattivazione I_HT
        l real = 0.01  # Attivazione I_LT
        r real = 0.99  # Inattivazione I_LT
        m real = 0.01  # Attivazione I_Na
        h real = 0.99  # Inattivazione I_Na

    parameters:
        # Conduttanze massime (dal paper: 0.15 uS = 150 nS, ecc.)
        g_HT nS = 150.0 nS       # Kv3.1 (Imposta a 0 per simulare la mutazione/blocco TEA)
        g_LT nS = 20.0 nS        
        g_Na nS = 500.0 nS       
        g_L nS = 2.0 nS          # Conduttanza di Leak
        
        # Potenziali di inversione
        E_K mV = -80.0 mV
        E_Na mV = 50.0 mV
        E_L mV = -57.0 mV
        
        C_m pF = 10.0 pF         # Capacità di membrana (0.01 nF = 10 pF)
        refr_T ms = 2.0 ms       # Periodo refrattario

        # Parametri sinaptici e di stimolo
        tau_syn_exc ms = 0.2 ms
        tau_syn_inh ms = 2.0 ms
        I_e pA = 0 pA            # Corrente di base

    equations:
        # Sinapsi
        kernel K_syn_inh = (e/tau_syn_inh) * t * exp(-t/tau_syn_inh)
        kernel K_syn_exc = (e/tau_syn_exc) * t * exp(-t/tau_syn_exc)
        inline I_syn_exc pA = convolve(K_syn_exc, exc_spikes) * pA
        inline I_syn_inh pA = convolve(K_syn_inh, inh_spikes) * pA

        # Correnti Ionice (modellate sulle equazioni del paper)
        # Il parametro gamma per I_HT è 0.1, quindi (1 - 0.1 + 0.1*p) diventa (0.9 + 0.1*p)
        inline I_HT pA = g_HT * (n**3) * (0.9 + 0.1 * p) * (V_m - E_K)
        inline I_LT pA = g_LT * (l**4) * r * (V_m - E_K)
        inline I_Na pA = g_Na * (m**3) * h * (V_m - E_Na)
        inline I_Leak pA = g_L * (V_m - E_L)

        # Cinetica I_HT (Kv3.1)
        inline alpha_n real = 0.2719 * exp(0.04 * V_m / mV)
        inline beta_n real  = 0.1974
        n' = (alpha_n * (1 - n) - beta_n * n) / ms

        inline alpha_p real = 0.00713 * exp(-0.1942 * V_m / mV)
        inline beta_p real  = 0.0935 * exp(0.0058 * V_m / mV)
        p' = (alpha_p * (1 - p) - beta_p * p) / ms

        # Cinetica I_LT
        inline alpha_l real = 1.2 * exp(0.03512 * V_m / mV)
        inline beta_l real  = 0.2248 * exp(-0.0319 * V_m / mV)
        l' = (alpha_l * (1 - l) - beta_l * l) / ms

        inline alpha_r real = 0.0438 * exp(-0.0053 * V_m / mV)
        inline beta_r real  = 0.0562 * exp(-0.0047 * V_m / mV)
        r' = (alpha_r * (1 - r) - beta_r * r) / ms

        # Cinetica I_Na
        inline alpha_m real = 76.4 * exp(0.037 * V_m / mV)
        inline beta_m real  = 0.0381 * exp(-0.043 * V_m / mV)
        m' = (alpha_m * (1 - m) - beta_m * m) / ms

        inline alpha_h real = 0.00013 * exp(-0.1216 * V_m / mV)
        inline beta_h real  = 1.999 * exp(0.0384 * V_m / mV)
        h' = (alpha_h * (1 - h) - beta_h * h) / ms

        # Equazione differenziale del potenziale di membrana
        V_m' = ( -(I_HT + I_LT + I_Na + I_Leak) + I_e + I_stim + I_syn_exc - I_syn_inh ) / C_m
        
        # Timer refrattario
        refr_t' = -1e3 * ms/s

    input:
        exc_spikes <- excitatory spike
        inh_spikes <- inhibitory spike
        I_stim pA <- continuous

    output:
        spike

    update:
        V_m_old = V_m
        if refr_t > 0 ms:
            integrate_odes(V_m, n, p, l, r, m, h, refr_t)
        else:
            integrate_odes(V_m, n, p, l, r, m, h)

    onCondition(refr_t <= 0 ms and V_m > 0 mV and V_m_old > V_m):
        refr_t = refr_T
        emit_spike()
